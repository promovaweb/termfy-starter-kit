{
  "name": "termfy-starter-kit",
  "version": "0.2.0",
  "description": "Esqueleto de CLI, TUI e servidor MCP stdio em Bun, com as skills do framework Termfy instaladas.",
  "type": "module",
  "private": true,
  "license": "UNLICENSED",
  "bin": {
    "termfy": "src/main.ts"
  },
  "termfy": {
    "bin": "termfy",
    "titulo": "Termfy",
    "autor": "Promovaweb",
    "site": "https://promovaweb.com",
    "repositorio": "https://github.com/promovaweb/termfy-starter-kit",
    "framework": "https://github.com/promovaweb/termfy"
  },
  "scripts": {
    "dev": "bun run src/main.ts",
    "start": "bun run src/main.ts",
    "tui": "bun run src/main.ts",
    "mcp": "bun run src/main.ts mcp",
    "build": "bun run scripts/build.ts",
    "build:todos": "bun run scripts/build.ts --todos",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit",
    "opencli": "bun run src/main.ts --opencli > docs/opencli.json",
    "opencli:check": "bun run scripts/conferir-opencli.ts",
    "skills:instalar": "npx -y skills add https://github.com/promovaweb/termfy -y -a universal -a claude-code -a codex -a opencode -a cursor -a gemini-cli",
    "skills:update": "npx -y skills update -y -p",
    "skills:check": "bun run scripts/conferir-skills.ts",
    "iniciar": "bun run scripts/iniciar.ts",
    "ebook": "bun run .ebook/build-ebook.mjs",
    "ebook:verify": "bun run .ebook/build-ebook.mjs --check",
    "validar": "bun run typecheck && bun test && bun run skills:check && bun run opencli:check && bun run ebook:verify && bun run build"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/promovaweb/termfy-starter-kit.git"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@opentui/core": "^0.8.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "@types/bun": "^1.3.14",
    "typescript": "^5.9.3"
  }
}
