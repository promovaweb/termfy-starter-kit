# Chave mestra opcional para cifrar credentials.json.
# Sem esta variável, o CLI gera e usa ~/.termfy/master.key.
# Gere um valor com: openssl rand -hex 32
# TERMFY_MASTER_KEY=

# Diretório alternativo para settings.json e credentials.json.
# Padrão: ~/.termfy
# TERMFY_HOME=

# Desliga cores na saída de texto (padrão da comunidade: https://no-color.org).
# NO_COLOR=1
